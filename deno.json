{
  "name": "@varavel/nodx-lucide",
  "version": "0.0.0",
  "exports": "./src/index.ts",
  "license": "MIT",
  "minimumDependencyAge": 0,
  "tasks": {
    "codegen": "deno run -A ./scripts/build/codegen.ts",
    "build": "deno run -A ./scripts/build/main.ts",
    "format": "deno fmt",
    "lint": "deno lint",
    "check": "deno check src/**/*.ts scripts/**/*.ts",
    "test": "deno test -A && node ./scripts/test_node.mjs",
    "ci": "deno task codegen && deno task build && deno fmt --check && deno task lint && deno task check && deno task test"
  },
  "exclude": [
    "./npm",
    "./tmp"
  ],
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@0.43.2",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@varavel/nodx": "jsr:@varavel/nodx@^1.0.0"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": [
      "./src/generated/"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  },
  "publish": {
    "include": [
      "src/",
      "README.md",
      "LICENSE"
    ]
  }
}
